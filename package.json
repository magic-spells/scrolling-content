{
	"name": "@magic-spells/scrolling-content",
	"version": "2.0.0",
	"description": "Infinite scrolling marquee web component — hover to pause, drag to scrub, no dependencies",
	"author": "Cory Schulz",
	"license": "MIT",
	"type": "module",
	"main": "dist/scrolling-content.esm.js",
	"module": "dist/scrolling-content.esm.js",
	"types": "dist/scrolling-content.d.ts",
	"unpkg": "dist/scrolling-content.min.js",
	"jsdelivr": "dist/scrolling-content.min.js",
	"exports": {
		".": {
			"types": "./dist/scrolling-content.d.ts",
			"import": "./dist/scrolling-content.esm.js",
			"default": "./dist/scrolling-content.esm.js"
		}
	},
	"sideEffects": true,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/magic-spells/scrolling-content.git"
	},
	"homepage": "https://github.com/magic-spells/scrolling-content#readme",
	"bugs": {
		"url": "https://github.com/magic-spells/scrolling-content/issues"
	},
	"keywords": [
		"scrolling",
		"marquee",
		"ticker",
		"logo-carousel",
		"infinite-scroll",
		"web-components",
		"custom-elements",
		"accessibility"
	],
	"files": [
		"dist/"
	],
	"scripts": {
		"build": "NODE_ENV=production node scripts/build.mjs",
		"dev": "NODE_ENV=development node scripts/build.mjs",
		"lint": "eslint src/ scripts/",
		"format": "prettier --write .",
		"prepublishOnly": "npm run build"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"devDependencies": {
		"@eslint/js": "^9.38.0",
		"@magic-spells/vite-plugin-live-reload": "^0.1.0",
		"eslint": "^9.38.0",
		"globals": "^15.15.0",
		"lightningcss": "^1.29.3",
		"prettier": "^3.3.3",
		"terser": "^5.16.0",
		"vite": "^8.0.10"
	}
}
